# -------------------------------
# Flutter / Dart
# -------------------------------
.dart_tool/
.packages
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
.metadata
.pub-cache/

# Generated by Flutter tooling
**/generated_plugin_registrant.dart
**/flutter_export_environment.sh

# Coverage
coverage/

# -------------------------------
# Android
# -------------------------------
**/android/.gradle/
**/android/captures/
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/android/**/key.properties
**/android/**/keystore.properties
**/android/**/*.keystore
**/android/**/*.jks

# -------------------------------
# iOS / macOS
# -------------------------------
**/ios/Flutter/.last_build_id
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/ephemeral/
**/ios/Flutter/flutter_export_environment.sh
**/ios/Pods/
**/ios/.symlinks/
**/ios/Runner.xcworkspace/
**/ios/xcuserdata/
**/ios/**/*.mode1v3
**/ios/**/*.mode2v3
**/ios/**/*.moved-aside
**/ios/**/*.pbxuser
**/ios/**/*.perspectivev3

# CocoaPods lock can be committed for apps if you prefer reproducible builds.
# Keeping it tracked by default, so NOT ignored here.
# **/ios/Podfile.lock

# -------------------------------
# Web
# -------------------------------
**/web/.dart_tool/

# -------------------------------
# Linux / Windows generated folders (if present)
# -------------------------------
**/linux/flutter/ephemeral/
**/windows/flutter/ephemeral/
**/macos/Flutter/ephemeral/

# -------------------------------
# IDE / Editor
# -------------------------------
.idea/
.vscode/
*.iml
*.ipr
*.iws

# VSCode launch/tasks/settings can be committed if team-shared.
# Ignore by default for privacy/local setup.
.vscode/*
!.vscode/extensions.json

# -------------------------------
# OS files
# -------------------------------
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# -------------------------------
# Logs / temp
# -------------------------------
*.log
*.tmp
*.temp
*.swp
*.swo

# -------------------------------
# Secrets / env (current + future)
# -------------------------------
.env
.env.*
*.env
*.secret
*.secrets
*.pem
*.p12
*.mobileprovision

# Firebase / Google service configs (uncomment if you do NOT want to commit them)
# android/app/google-services.json
# ios/Runner/GoogleService-Info.plist

# -------------------------------
# Tooling caches
# -------------------------------
.cache/
.npm/
.yarn/
pnpm-lock.yaml
node_modules/

# -------------------------------
# Test artifacts
# -------------------------------
*.lcov

# -------------------------------
# Git / patch leftovers
# -------------------------------
*.orig
*.rej
